@page "/Conversions/{conversionType?}/{input?}"
@model UnitConverter.Pages.ConversionsModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>

</head>
<body>
<div>
    @if (ViewData["ErrorMessage"] != null)
    {

        <p class="text-danger">@ViewData["ErrorMessage"]</p>
    }
    else
    {

        <h1>@ViewData["ConversionType"]</h1>
        <p>Conversion: @Model.ConversionType</p>
        <p>Input: @Model.Input</p>
        <p>Output: @Model.Output</p>
    }
</div>
</body>
</html>
